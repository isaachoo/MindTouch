{
  "name": "mindtouch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-data.mjs data/carer_quotes.csv src/carer/data/quotes.json",
    "carers:weekly": "node scripts/carers-weekly.mjs --details --git-publish",
    "carers:directory": "node scripts/carers-weekly.mjs --directory-only --details --skip-sites",
    "carers:websites": "node scripts/carers-weekly.mjs --watch-only",
    "carers:extract": "node scripts/carers-weekly.mjs --extract-only --import-file data/carers/queues/extracted_services.json",
    "carers:publish": "node scripts/carers-weekly.mjs --publish-only --git-publish",
    "test:carers": "node --test scripts/carers-weekly.test.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.135.0"
  }
}
